# Copy this file to .env.local (local) or add these in your hosting provider's
# environment variable settings. All values are public (they end up in the HTML).

# Optional: the production domain, no trailing slash. Defaults to https://quicktoolsworld.com.
# Used for canonical URLs, the sitemap, robots.txt and social sharing tags.
# NEXT_PUBLIC_SITE_URL=https://quicktoolsworld.com

# Optional: public contact email. Defaults to support@quicktoolsworld.com.
# NEXT_PUBLIC_CONTACT_EMAIL=support@quicktoolsworld.com

# --- Google AdSense (optional) ---
# Your publisher ID from AdSense (Account > Settings > Account information), e.g. ca-pub-1234567890123456.
# Setting only this adds the AdSense verification meta tag and /ads.txt. No ads or cookies yet.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Set to "true" only AFTER your site is approved AND you have set up a consent message (see README).
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Ad unit IDs (the data-ad-slot number) from AdSense > Ads > By ad unit. Leave empty to show no ad there.
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_BELOW=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_FOOTER=

# --- Contact form (Brevo) ---
# Server-only secrets: never prefix these with NEXT_PUBLIC_.
# Create an API key in Brevo: SMTP & API -> API keys. Without it, the form shows
# an error and asks visitors to email you directly.
BREVO_API_KEY=
# Inbox that receives contact-form messages (default: support@quicktoolsworld.com).
CONTACT_TO_EMAIL=support@quicktoolsworld.com
# Sender address. It must be a verified sender in Brevo (Senders, domains & dedicated IPs),
# ideally on your authenticated quicktoolsworld.com domain.
CONTACT_FROM_EMAIL=support@quicktoolsworld.com
CONTACT_FROM_NAME=QuickToolsWorld Contact Form
